# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GEMINI_API_KEYS: Optional comma-separated list of multiple Gemini API keys for automatic Round-Robin Rotation and Rate Limit (429) failover.
GEMINI_API_KEYS=

# OPENAI_API_KEY: Optional API key for OpenAI ChatGPT 4.0 / gpt-4o.
# Automatically used as backup/fallback when Gemini quota runs out or when set as primary LLM.
OPENAI_API_KEY=

# OPENAI_API_KEYS: Optional comma-separated list of multiple OpenAI API keys for automatic key rotation.
OPENAI_API_KEYS=

# OPENAI_MODEL: OpenAI model to use (default: gpt-4o, also supports gpt-4o-mini, gpt-4-turbo)
OPENAI_MODEL=gpt-4o

# LLM_PROVIDER: Preferred primary LLM provider ('auto' | 'gemini' | 'openai')
LLM_PROVIDER=auto

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# SORA_API_KEY: Optional API key for Sora video generation in production
SORA_API_KEY=

# RUNWAY_API_KEY: Optional API key for Runway Gen-3 Image-to-Video generation (Must start with 'key_')
RUNWAY_API_KEY=

# FAL_KEY: Dedicated Fal.ai API key (UUID:secret format)
FAL_KEY=

# FAL_API_KEYS: Comma-separated list of Fal.ai API keys for round-robin rotation
FAL_API_KEYS=

# FAL_MODEL: Default Fal.ai model (default: fal-ai/veo3.1/lite/image-to-video)
FAL_MODEL=fal-ai/veo3.1/lite/image-to-video

# BYTEPLUS_API_KEY: API key for BytePlus ModelArk / Doubao video generation
BYTEPLUS_API_KEY=

# BYTEPLUS_MODEL: BytePlus Model Identifier (default: dreamina-seedance-2-0-mini-260615)
BYTEPLUS_MODEL=dreamina-seedance-2-0-mini-260615

# BYTEPLUS_BASE_URL: BytePlus API Gateway Endpoint
BYTEPLUS_BASE_URL=https://ark.ap-southeast-1.byteplusapi.com/api/v3

# VIDEO_PROVIDER: Choose 'byteplus' | 'veo' | 'fal' | 'runway' | 'sora'
VIDEO_PROVIDER=byteplus

# VEO_API_KEY: Dedicated Google Veo (Asli) API key (or uses GEMINI_API_KEY by default)
VEO_API_KEY=

# VEO_API_KEYS: Comma-separated list of Google Veo API keys for round-robin rotation
VEO_API_KEYS=

# VEO_MODEL: Default Google Veo model ('veo-2.0-generate-video' | 'veo-3.0-generate-video')
VEO_MODEL=veo-2.0-generate-video

# FOUNDER_ACCESS_KEY: Master Secret Key for Founder Control Center authentication
FOUNDER_ACCESS_KEY=

# GOOGLE_CLOUD_PROJECT: GCP Project ID for Cloud Tasks & Cloud Storage
GOOGLE_CLOUD_PROJECT=

# GCS_BUCKET_NAME: Google Cloud Storage bucket for persistent video and audio renders
GCS_BUCKET_NAME=neuronna-media-vault

# GOOGLE_CLOUD_LOCATION: GCP region for Cloud Tasks (e.g. asia-southeast1, us-central1)
GOOGLE_CLOUD_LOCATION=asia-southeast1

# CLOUD_TASKS_QUEUE: Queue name in Cloud Tasks for asynchronous video rendering
CLOUD_TASKS_QUEUE=neuronna-video-render-queue

# WORKER_SECRET: Authentication secret between Cloud Tasks and background worker endpoint
WORKER_SECRET=neuronna-internal-worker-secret-2025


-e 
# JWT_SECRET: Secret for signing JWT sessions
JWT_SECRET=
